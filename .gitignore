# ==============================================================================
# Creativa Flutter & Dart Diploma - Professional .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# Dart & Pub Tools
# https://dart.dev/tools/private-files
# ------------------------------------------------------------------------------
.dart_tool/
.packages
build/

# Generated documentation and coverage
doc/api/
coverage/

# Pub cache and temporary files
.pub-cache/
.pub/

# ------------------------------------------------------------------------------
# IDEs & Text Editors
# ------------------------------------------------------------------------------
# Android Studio & IntelliJ IDEA
.idea/
*.iml
*.iws
*.ipr
out/

# Visual Studio Code
.vscode/

# Other Editors & Temp buffers
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# ------------------------------------------------------------------------------
# Flutter & Platform Builds (Ready for Flutter Phase)
# ------------------------------------------------------------------------------
.flutter-plugins
.flutter-plugins-dependencies

# Android build outputs & local configs
.gradle/
local.properties
**/android/**/gradle-app.setting
**/android/**/captures/
**/android/**/.gradle/
**/android/**/build/

# iOS / macOS build outputs
**/ios/**/Pods/
**/ios/**/.symlinks/
**/ios/**/Flutter/Flutter.framework
**/ios/**/Flutter/Flutter.podspec
**/ios/**/DerivedData/

# Desktop & Web build artifacts
**/windows/flutter/ephemeral/
**/linux/flutter/ephemeral/

# ------------------------------------------------------------------------------
# Operating System & Cache Files
# ------------------------------------------------------------------------------
# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
.directory

# ------------------------------------------------------------------------------
# Logs & Temporary Files
# ------------------------------------------------------------------------------
*.log
*.crash
*.tmp
*.bak
